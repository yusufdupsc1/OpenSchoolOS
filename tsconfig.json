{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@openschoolos/domain": ["packages/domain/src"],
      "@openschoolos/shared": ["packages/shared/src"],
      "@openschoolos/ui": ["packages/ui/src"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", "**/__pycache__/**"]
}
